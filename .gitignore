/src/generated/prisma

# Agent skill docs installed by `prisma init`. Regenerate with
# `npx prisma skills sync`; skills-lock.json is committed so versions are
# reproducible.
.agents/
.windsurf/

# Local-disk file store. KYC documents land here in development — identity
# proofs, PAN cards, bank details. Never commit them. In production these live
# in a private S3 bucket and this directory does not exist.
/storage
