# HelloFit API environment.
#
# The shape is enforced by `src/config/env.validation.ts`, which runs once at
# startup — a missing DATABASE_URL or a short JWT secret fails the boot rather
# than surfacing later as a confusing 500.
#
# Copy to `.env` and fill in. Everything above the "Optional" line is required.

# development | test | production
#
# `production` is NOT bootable today: StorageModule throws unless an
# S3-compatible StoragePort is implemented and bound (storage.module.ts), and
# PaymentModule and NotificationModule demand live credentials. See
# `deploy/README.md` — the review deployment runs `development` behind an Nginx
# IP allowlist, deliberately, because development returns the OTP in the
# response body.
NODE_ENV=development

# 4000, not 3000: the review VPS already hosts another project. Must match the
# upstream in deploy/nginx/hellofit.conf and PORT in the PM2 ecosystem file.
PORT=4000

# Postgres 16. Prisma 7.10.1 with the pg adapter.
DATABASE_URL=postgresql://hellofit:CHANGE_ME@localhost:5432/hellofit?schema=public

# Both must be at least 32 characters, and must DIFFER from each other in
# production (validateEnv refuses otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Optional in development — each module falls back to a stand-in and logs that
# it did. Every one of them refuses to boot in production without these.
# ---------------------------------------------------------------------------

# Payments. Without these PaymentModule uses the MANUAL gateway, which signs
# with a local HMAC and settles nothing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where the local-disk file store writes KYC documents. Development only —
# these are not backed up and a redeploy loses them.
STORAGE_ROOT=./var/storage

# Origin that signed download URLs are built on, e.g. https://api.hellofit.in
# Empty yields a relative URL resolved against the app's own base.
PUBLIC_BASE_URL=

# Firebase Cloud Messaging (push). All three come from the service-account JSON
# key. Without them notifications are written to the log instead of delivered.
# FIREBASE_PRIVATE_KEY arrives with literal \n sequences; FcmPushSender
# unescapes them, so paste it as-is inside quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
